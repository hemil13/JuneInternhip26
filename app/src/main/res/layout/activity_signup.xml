<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".SignupActivity">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="80dp"
        android:layout_marginBottom="30dp"
        android:gravity="center"
        android:text="Create Account"
        android:textColor="#1F41BB"
        android:textSize="30dp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Create an account so you can explore all the existing jobs"
        android:layout_marginHorizontal="20dp"
        android:gravity="center"
        android:textSize="18dp"
        />

    <EditText
        android:id="@+id/name_signup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="50dp"
        android:background="@drawable/custom_background"
        android:hint="Name"
        android:drawableLeft="@drawable/user_svgrepo_com"
        android:drawablePadding="8dp"
        android:inputType="text"
        android:padding="15dp" />

    <EditText
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:hint="Email"
        android:id="@+id/email_signup"
        android:inputType="textEmailAddress"
        android:layout_marginHorizontal="20dp"
        android:drawableLeft="@drawable/email_svgrepo_com"
        android:drawablePadding="8dp"
        android:padding="15dp"
        android:background="@drawable/custom_background"
        />

    <EditText
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:hint="Contact"
        android:drawableLeft="@drawable/contact_new_svgrepo_com"
        android:drawablePadding="8dp"
        android:id="@+id/contact_signup"
        android:inputType="phone"
        android:layout_marginHorizontal="20dp"
        android:padding="15dp"
        android:background="@drawable/custom_background"
        />

    <EditText
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:hint="Password"
        android:id="@+id/password_signup"
        android:drawableLeft="@drawable/lock_svgrepo_com"
        android:drawablePadding="8dp"
        android:inputType="textPassword"
        android:layout_marginHorizontal="20dp"
        android:padding="15dp"
        android:background="@drawable/custom_background"
        />

    <EditText
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:hint="Confirm Password"
        android:id="@+id/confirm_password_signup"
        android:drawableLeft="@drawable/lock_svgrepo_com"
        android:drawablePadding="8dp"
        android:inputType="textPassword"
        android:layout_marginHorizontal="20dp"
        android:padding="15dp"
        android:background="@drawable/custom_background"
        />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Already Have An Account"
        android:textSize="18dp"
        android:layout_marginHorizontal="20dp"
        android:gravity="center"
        android:layout_marginTop="40dp"
        />

    <Button
        style="@style/button_20"
        app:backgroundTint="@null"
        android:text="Sign Up"
        />



</LinearLayout>